# Copy to .env.local and fill in. ops-hub runs on port 3030 in dev.

# ── Supabase (shared OCG project) ──────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Ops Hub URL + agent API key ────────────────────────────────
# Public base URL for completion links + the oc-ops CLI.
NEXT_PUBLIC_OPS_URL=https://ops.onecoregroup.com
OPS_OPS_BASE_URL=https://ops.onecoregroup.com
# 64-hex shared secret gating /api/agent/* (the agent callback API).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OPS_AGENT_API_KEY=

# HMAC secret for no-login task completion links.
OPS_TASK_TOKEN_SECRET=generate_a_random_secret_here

# ── Email (Resend) ─────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_key_here
OPS_EMAIL_FROM=ops@onecoregroup.com

# ── AI specialists (Groq) ──────────────────────────────────────
GROQ_API_KEY=

# ── Google Drive delivery (service account) ────────────────────
# Service-account JSON, base64-encoded. The account needs Editor on the
# OCG "Brands/Clients" Drive root, which inherits to every subfolder.
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
# Root folder all brand/client work lives under.
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# ── Cron security ──────────────────────────────────────────────
CRON_SECRET=generate_a_random_secret_here
