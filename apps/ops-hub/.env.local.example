# Copy to .env.local and fill in. ops-hub runs on port 3030 in dev.

# ── Supabase (shared OCG project) ──────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Ops Hub URL + agent API key ────────────────────────────────
# Public base URL for completion links + the oc-ops CLI.
NEXT_PUBLIC_OPS_URL=https://ops.onecoregroup.com
OPS_OPS_BASE_URL=https://ops.onecoregroup.com
# 64-hex shared secret gating /api/agent/* (the agent callback API).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OPS_AGENT_API_KEY=

# HMAC secret for no-login task completion links.
OPS_TASK_TOKEN_SECRET=generate_a_random_secret_here

# ── Email (Resend) ─────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_key_here
OPS_EMAIL_FROM=ops@onecoregroup.com
# Comma-separated recipients for the daily/weekly/monthly ops reports.
OPS_REPORT_RECIPIENTS=wallace@onecoregroup.com

# ── Groq — REPORTS ONLY ────────────────────────────────────────
# Used solely for the daily/weekly/monthly ops report narration. The task agent
# is orchestrated by Codex/Hermes/Claude Code via the oc-* skills, NOT Groq.
GROQ_API_KEY=

# ── Google Drive delivery — sharable Google Docs ───────────────
# RECOMMENDED for a free Gmail: OAuth as your own account. Docs are owned by
# you (sharable, 15GB quota). Service accounts CANNOT (no storage quota) unless
# you have Google Workspace + a Shared Drive.
#   1) Google Cloud Console → create a Desktop-app OAuth client; enable Drive API.
#   2) Set the two below, then run:  node scripts/google-oauth.mjs
#   3) Paste the printed GOOGLE_OAUTH_REFRESH_TOKEN here + in Vercel.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=        # the shared root folder that holds the brand folders
GOOGLE_DRIVE_ROOT_FOLDER_NAME=One Core Group — Ops Deliverables
OPS_DRIVE_SHARE=anyone   # 'anyone' = link-shareable view; 'none' = private
# Optional brand slug → Drive folder id map. Use when your brand folders aren't
# named like the brand slugs. JSON, one line:
#   {"nairobi-piano-technicians":"<id>","glitz-n-glim":"<id>", ...}
GOOGLE_DRIVE_BRAND_FOLDERS=

# Workspace-only alternative — service account with Domain-Wide Delegation.
# Requires Google Workspace (a managed domain). Authorize the SA's Client ID +
# the scope https://www.googleapis.com/auth/drive in the Workspace Admin console
# (Security → API controls → Domain-wide delegation), then impersonate a real
# Workspace user so created files are owned by them (quota-backed):
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
GOOGLE_IMPERSONATE_SUBJECT=        # e.g. ops@onecoregroup.com (Workspace user to act as)
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# If neither Drive option is set, delivery falls back to Supabase Storage.

# ── Cron security ──────────────────────────────────────────────
CRON_SECRET=generate_a_random_secret_here

# ── Marketing Hub callback (return approved deliverables to the calendar) ─
# The marketing-hub ops-callback URL + a secret shared with marketing-hub.
MARKETING_WEBHOOK_URL=https://hub.onecoregroup.com/api/marketing/ops-callback
MARKETING_WEBHOOK_SECRET=
